# VoxCraft Production Environment Variables
# Edit this file to customize settings. After editing, redeploy:
#   sudo bash scripts/deploy.sh

# Database (SQLite with absolute path)
DATABASE_URL=sqlite+aiosqlite:////opt/voxcraft/data/voxcraft.db

# Redis (local, managed by Nomad)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Audio output (absolute path)
AUDIO_OUTPUT_DIR=/opt/voxcraft/audio_output

# TTS Server (qwen-tts-server, adjust host if on a different machine)
TTS_SERVER_URL=http://localhost:8000
TTS_SERVER_API_KEY=dummy

# CORS (adjust for production domain)
CORS_ORIGINS='["http://localhost:8001"]'

# Auth
SECRET_KEY=change-me-in-production

# Worker settings
WORKER_CONCURRENCY=1
TASK_SOFT_TIME_LIMIT=1800
TASK_TIME_LIMIT=3600
