# ttsQwen Environment Variables
# Copy this file to .env and adjust values as needed.

# Environment (development or production)
ENVIRONMENT=development

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./voxcraft.db

# Redis (message broker for Celery)
REDIS_URL=redis://localhost:6379/0

# Audio output directory (where generated files are saved)
AUDIO_OUTPUT_DIR=./audio_output

# Celery broker and result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication
SECRET_KEY=change-me-in-production-use-a-random-string
ACCESS_TOKEN_EXPIRE_DAYS=7
# Cookie domain (e.g. .yourdomain.com for cross-subdomain; leave empty for default)
COOKIE_DOMAIN=

# Proxy (set true when behind Cloudflare or nginx)
BEHIND_PROXY=false

# CORS allowed origins (JSON list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3005"]

# TTS Server (OpenAI-compatible HTTP API)
TTS_SERVER_URL=http://192.168.4.35:8000
TTS_SERVER_API_KEY=dummy

# GPU device for TTS inference (legacy — only used if loading model locally)
GPU_DEVICE=cuda:0

# Worker settings
WORKER_CONCURRENCY=1
TASK_SOFT_TIME_LIMIT=300
TASK_TIME_LIMIT=600
